# Spec: SPEC-006 §2. Copy locally to .env; never commit .env or real credentials.
# P5 owns the .gitignore rule excluding .env.
# Provider credentials: replace placeholders only in your private environment.
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
# Optional: not needed for the default DuckDuckGo search provider.
SEARCH_API_KEY=replace-with-search-key
# Optional configuration overrides (CLI flags take precedence).
AGENT_HARNESS_CONFIG=./config.yaml
AGENT_HARNESS_LOG_LEVEL=INFO
AGENT_HARNESS_OUTPUT_DIR=./output
